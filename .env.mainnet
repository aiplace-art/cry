# ========================================
# BNB Chain Mainnet Configuration
# ========================================
# ⚠️ CRITICAL: This file contains production secrets!
# Never commit this file to version control!
# ========================================

# BNB Chain Mainnet RPC
BSC_RPC_URL=https://bsc-dataseed1.binance.org
BSC_BACKUP_RPC_URL=https://bsc-dataseed2.binance.org
BSC_BACKUP_RPC_URL_2=https://bsc-dataseed3.binance.org

# Private Key (MUST start with 0x)
# ⚠️ KEEP THIS SECRET! This is your deployment wallet
PRIVATE_KEY=0x...your_mainnet_private_key_here...

# BscScan API Key for contract verification
# Get from: https://bscscan.com/myapikey
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Gas Configuration for Mainnet
# Recommended: 5 Gwei for normal, 10 Gwei for fast deployment
GAS_PRICE_GWEI=5
GAS_LIMIT=8000000

# Contract Deployment Configuration
# Token Configuration
TOKEN_NAME=HypeAI
TOKEN_SYMBOL=HYPEAI
TOTAL_SUPPLY=10000000000000000000000000000

# Treasury and Team Wallets (MUST be valid addresses)
TREASURY_WALLET=0x...treasury_wallet_address...
TEAM_WALLET=0x...team_wallet_address...
MARKETING_WALLET=0x...marketing_wallet_address...
LIQUIDITY_WALLET=0x...liquidity_wallet_address...

# Private Sale Configuration
PRIVATE_SALE_TOKEN_PRICE=100000000000000
PRIVATE_SALE_HARD_CAP=1000000000000000000000
PRIVATE_SALE_MIN_PURCHASE=10000000000000000
PRIVATE_SALE_MAX_PURCHASE=50000000000000000000

# Referral System Configuration
REFERRAL_LEVEL1_PERCENT=500
REFERRAL_LEVEL2_PERCENT=300
REFERRAL_LEVEL3_PERCENT=200

# Vesting Configuration
VESTING_CLIFF_DURATION=7776000
VESTING_TOTAL_DURATION=31536000

# Staking Configuration
STAKING_MIN_AMOUNT=1000000000000000000
STAKING_APY_PERCENT=1200

# Governance Configuration
GOVERNANCE_QUORUM_PERCENT=400
GOVERNANCE_VOTING_PERIOD=259200

# Oracle Configuration (Chainlink BNB/USD on BSC Mainnet)
CHAINLINK_BNB_USD_FEED=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE

# Deployment Options
VERIFY_CONTRACTS=true
SAVE_DEPLOYMENT_LOG=true
DEPLOYMENT_LOG_PATH=./deployments/mainnet

# Safety Checks
REQUIRE_BALANCE_CHECK=true
MIN_DEPLOYER_BALANCE_BNB=0.5

# Multi-Signature Settings (Optional, for production security)
USE_MULTISIG=false
MULTISIG_WALLET=0x...multisig_wallet_address...
MULTISIG_REQUIRED_CONFIRMATIONS=2

# CoinMarketCap API (for gas reporting)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Monitoring & Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Deployment Strategy
DEPLOY_WITH_DELAY=true
DEPLOY_DELAY_SECONDS=10
MAX_RETRIES=3
RETRY_DELAY_SECONDS=30
