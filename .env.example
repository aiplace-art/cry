# ============================================
# HYPEAI ENVIRONMENT VARIABLES
# ============================================
#
# IMPORTANT:
# - Copy this file to .env for development
# - NEVER commit .env with real keys to git
# - Keep all API keys secure and private
# ============================================

# ============================================
# AI API CONFIGURATION (Phase 2)
# ============================================

# Choose AI provider: 'openai', 'anthropic', or 'local'
AI_PROVIDER=openai

# OpenAI API Key (for GPT-4 integration)
# Get your key at: https://platform.openai.com/api-keys
# Cost: ~$500/month for 1M tokens with GPT-4
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (for Claude integration)
# Get your key at: https://console.anthropic.com/
# Cost: ~$300/month for 1M tokens with Claude Opus
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# AI Model Selection
# OpenAI: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229
AI_MODEL=gpt-4-turbo-preview

# AI Configuration
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_STREAMING_ENABLED=true

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================

# Ethereum/BSC Configuration
MAINNET_RPC_URL=https://bsc-dataseed.binance.org/
TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# Private Keys (NEVER commit real keys!)
DEPLOYER_PRIVATE_KEY=your-private-key-here
ADMIN_PRIVATE_KEY=your-admin-private-key-here

# Contract Addresses (fill after deployment)
HYPE_TOKEN_ADDRESS=
STAKING_CONTRACT_ADDRESS=
GOVERNANCE_CONTRACT_ADDRESS=
PRIVATE_SALE_ADDRESS=

# ============================================
# SOCIAL MEDIA AUTOMATION
# ============================================

# Twitter API v2 (for auto-posting)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-access-token
TWITTER_ACCESS_SECRET=your-access-secret
TWITTER_BEARER_TOKEN=your-bearer-token

# Instagram API
INSTAGRAM_ACCESS_TOKEN=your-instagram-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-account-id

# ============================================
# EMAIL CONFIGURATION
# ============================================

# Email Service (for notifications)
SENDGRID_API_KEY=your-sendgrid-key
MAILCHIMP_API_KEY=your-mailchimp-key

# Contact Email
CONTACT_EMAIL=hello@hypeai.io
SUPPORT_EMAIL=support@hypeai.io

# ============================================
# ANALYTICS & MONITORING
# ============================================

# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Mixpanel
MIXPANEL_TOKEN=your-mixpanel-token

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# ============================================
# DATABASE (if applicable)
# ============================================

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/hypeai

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# ============================================
# SECURITY
# ============================================

# JWT Secret (for authentication)
JWT_SECRET=your-super-secret-jwt-key-here

# Session Secret
SESSION_SECRET=your-session-secret-here

# Encryption Key (for sensitive data)
ENCRYPTION_KEY=your-32-character-encryption-key

# ============================================
# THIRD-PARTY SERVICES
# ============================================

# CoinMarketCap API (for token prices)
COINMARKETCAP_API_KEY=your-cmc-api-key

# Etherscan API (for contract verification)
ETHERSCAN_API_KEY=your-etherscan-key
BSCSCAN_API_KEY=your-bscscan-key

# Infura/Alchemy (backup RPC)
INFURA_PROJECT_ID=your-infura-project-id
ALCHEMY_API_KEY=your-alchemy-key

# ============================================
# DEVELOPMENT FLAGS
# ============================================

# Environment
NODE_ENV=development

# Debug Mode
DEBUG=true

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_AI_API=false
ENABLE_REAL_TIME_CHAT=false
ENABLE_AUTO_POSTING=false

# ============================================
# COST ESTIMATES (Phase 2)
# ============================================
#
# OpenAI GPT-4:
# - Input: $0.03 per 1K tokens
# - Output: $0.06 per 1K tokens
# - Average chat: ~1K tokens = $0.05
# - 10,000 chats/month = ~$500/month
#
# Anthropic Claude Opus:
# - Input: $0.015 per 1K tokens
# - Output: $0.075 per 1K tokens
# - Average chat: ~1K tokens = $0.045
# - 10,000 chats/month = ~$450/month
#
# Recommendation:
# - Start with pattern matching (free)
# - Monitor traffic for 1 month
# - Switch to real AI when traffic justifies cost
# - Consider Claude Haiku ($0.25/1M tokens) for cost-effective option
# ============================================
