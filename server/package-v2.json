{
  "name": "hypeai-ai-assistant-api-v2",
  "version": "2.0.0",
  "description": "HypeAI AI Assistant Backend API v2 - TypeScript, WebSocket, Redis",
  "main": "ai-assistant-api-v2.ts",
  "type": "module",
  "scripts": {
    "start": "tsx ai-assistant-api-v2.ts",
    "dev": "tsx watch ai-assistant-api-v2.ts",
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "keywords": [
    "ai",
    "assistant",
    "claude",
    "api",
    "hypeai",
    "typescript",
    "websocket",
    "redis",
    "realtime"
  ],
  "author": "HypeAI Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.17.0",
    "@sentry/node": "^7.92.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.6.0",
    "ioredis": "^5.3.2",
    "isomorphic-dompurify": "^2.4.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
