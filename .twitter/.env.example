# Twitter API Configuration for HypeAI Analytics

# Twitter API v2 Bearer Token
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_bearer_token_here

# HypeAI Twitter Account ID or Username
TWITTER_ACCOUNT_ID=HypeAI_Official

# Optional: Competitor accounts to track (comma-separated)
TWITTER_COMPETITORS=SolanaAI,PhantomWallet,SolanaFloor,MagicEden,JupiterExchange

# Analytics Settings
ANALYTICS_COLLECTION_INTERVAL=daily
ANALYTICS_RETENTION_DAYS=90

# Report Settings
GENERATE_DAILY_REPORTS=true
GENERATE_WEEKLY_REPORTS=true
REPORT_EMAIL=notifications@hypeai.io
