# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# API Configuration
MAX_TOKENS=4096
TEMPERATURE=0.7

# CORS
ALLOWED_ORIGIN=https://hypeai.io

# Analytics (Optional)
DISABLE_ANALYTICS=false
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_API_SECRET=your-ga-secret

# Express API Integration (Optional - for complex RAG queries)
EXPRESS_API_URL=https://hypeai-api.up.railway.app
EXPRESS_API_KEY=your-express-api-key

# Analytics Webhook (Optional)
ANALYTICS_WEBHOOK_URL=

# Environment
NODE_ENV=production
