# ============================================
# THREADS API CONFIGURATION
# ============================================

# Operating Mode: api, manual, or browser
# - api: Full automation with Threads API (requires Meta API access)
# - manual: Generate posting instructions for manual workflow
# - browser: Semi-automated browser automation (requires Playwright)
THREADS_MODE=manual

# Threads API Credentials (for API mode)
# Get these from: https://developers.facebook.com/apps
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_API_VERSION=v1.0

# Threads App Credentials (for token refresh)
THREADS_APP_ID=
THREADS_APP_SECRET=

# ============================================
# INSTAGRAM API CONFIGURATION
# ============================================

# Instagram Business Account
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ============================================
# CROSS-POSTING SETTINGS
# ============================================

# Minimum engagement (likes + retweets) before cross-posting from Twitter
CROSSPOST_MIN_ENGAGEMENT=5

# Delay in minutes before cross-posting (wait for engagement)
CROSSPOST_DELAY_MINUTES=30

# ============================================
# MULTI-PLATFORM SETTINGS
# ============================================

# Enabled platforms (comma-separated)
MULTIPLATFORM_PLATFORMS=twitter,threads

# Minutes to wait between posting to different platforms
MULTIPLATFORM_STAGGER_MINUTES=2

# Adapt content for each platform (true/false)
MULTIPLATFORM_ADAPT_CONTENT=true

# ============================================
# SCHEDULING SETTINGS
# ============================================

# Timezone for scheduling
SCHEDULE_TIMEZONE=America/New_York

# Target audience for optimal timing
SCHEDULE_TARGET_AUDIENCE=crypto_enthusiasts

# ============================================
# ANALYTICS SETTINGS
# ============================================

# Enable analytics collection (requires API mode)
ANALYTICS_ENABLED=true

# Analytics collection interval (hours)
ANALYTICS_COLLECTION_INTERVAL=12
