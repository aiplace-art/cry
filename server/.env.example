# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Server Configuration
PORT=3001
NODE_ENV=production

# CORS Configuration
CORS_ORIGIN=https://hypeai.io,http://localhost:3000
ALLOWED_ORIGINS=https://hypeai.io,http://localhost:3000,https://www.hypeai.io

# Rate Limiting (requests per window)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Session Configuration
SESSION_TIMEOUT_MS=3600000
MAX_CONTEXT_MESSAGES=20

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/api.log
LOG_QUERIES=true

# Knowledge Base
KNOWLEDGE_BASE_PATH=../docs/PROJECT_KNOWLEDGE_BASE.md
SYSTEM_PROMPT_PATH=./system-prompt.txt

# Analytics
TRACK_ANALYTICS=true
ANALYTICS_FILE=./analytics/usage.json

# Security
API_KEY_HEADER=X-API-Key
REQUIRE_API_KEY=false
TRUSTED_IPS=

# Performance
MAX_TOKENS=4096
TEMPERATURE=0.7
STREAM_RESPONSES=false
