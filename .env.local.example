# HypeAI - Groq API Configuration
# Copy this file to .env.local and add your actual API key

# ==============================================================================
# GROQ API CONFIGURATION
# ==============================================================================

# Get your API key from: https://console.groq.com
# Important: This key should NEVER be committed to git!
GROQ_API_KEY=gsk_your_actual_api_key_here

# Model Configuration
# Recommended: llama-3.3-70b-versatile (best Russian support)
# Alternatives: llama-3.1-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Generation Settings
GROQ_MAX_TOKENS=500
GROQ_TEMPERATURE=0.7

# ==============================================================================
# RATE LIMITING CONFIGURATION
# ==============================================================================

# Groq Free Tier Limits:
# - 30 requests per minute (RPM)
# - 7,000 tokens per minute (TPM)
# - ~200,000 tokens per day

# Client-side rate limits (per user)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# Server-side rate limits (global, stay below Groq limits for safety)
GROQ_MAX_REQUESTS_PER_MINUTE=25
GROQ_MAX_TOKENS_PER_MINUTE=6000
GROQ_MAX_TOKENS_PER_DAY=180000

# ==============================================================================
# OPTIONAL FEATURES
# ==============================================================================

# Streaming (faster UI responses)
GROQ_ENABLE_STREAMING=true

# Response caching (reduce API calls for common questions)
GROQ_ENABLE_CACHE=true
GROQ_CACHE_TTL=3600

# Fallback models (comma-separated, used if primary model unavailable)
GROQ_FALLBACK_MODELS=llama-3.1-70b-versatile,mixtral-8x7b-32768

# Logging
ENABLE_LOGGING=true
LOG_LEVEL=info

# Node Environment
NODE_ENV=production

# ==============================================================================
# SECURITY & MAINTENANCE
# ==============================================================================

# API Key Rotation Tracking
# Update this date when you rotate your API key (recommended: monthly)
GROQ_API_KEY_ROTATION_DATE=

# Last API key rotation reminder
# Set to current date after creating new key
GROQ_LAST_ROTATION=

# ==============================================================================
# SECURITY CHECKLIST
# ==============================================================================
# Before deploying, verify:
# ✓ .env.local is in .gitignore
# ✓ No API keys in git history
# ✓ API key stored in password manager backup
# ✓ Environment variables used (not hardcoded)
# ✓ Server-side API calls only (never from browser)
# ✓ Monthly rotation reminder set

# ==============================================================================
# SETUP INSTRUCTIONS
# ==============================================================================
# 1. Copy this file:
#    cp .env.local.example .env.local
#
# 2. Get your Groq API key:
#    - Visit https://console.groq.com
#    - Sign up or log in
#    - Go to "API Keys" section
#    - Click "Create API Key"
#    - Copy the key (shown only once!)
#
# 3. Update .env.local:
#    - Replace 'gsk_your_actual_api_key_here' with your real key
#    - Update GROQ_API_KEY_ROTATION_DATE with today's date
#
# 4. Verify .gitignore:
#    echo ".env.local" >> .gitignore
#
# 5. Test your setup:
#    node -e "require('dotenv').config({path:'.env.local'}); console.log('Key loaded:', !!process.env.GROQ_API_KEY)"
#
# 6. Read the docs:
#    - Quick start: docs/GROQ_QUICK_START.md
#    - Full guide: docs/GROQ_API_SETUP.md
#    - Troubleshooting: docs/GROQ_TROUBLESHOOTING.md

# ==============================================================================
# COST ESTIMATION (Free Tier)
# ==============================================================================
# Daily capacity: ~200,000 tokens
# Average usage: 150 tokens per conversation
# Daily conversations: ~1,333 conversations
# For 100 users: ~13 conversations per user
# Monthly cost: $0.00 (FREE!) 🎉
#
# Upgrade to paid tier when:
# - More than 500 daily active users
# - Consistently using >150,000 tokens/day
# - Need higher priority processing
# - Require better SLA guarantees
